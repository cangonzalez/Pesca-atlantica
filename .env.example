# Esta integracion acepta unicamente credenciales de prueba.
MERCADOPAGO_TEST_ACCESS_TOKEN=REEMPLAZAR_CON_EL_ACCESS_TOKEN_DE_CREDENCIALES_DE_PRUEBA
NEXT_PUBLIC_SITE_URL=https://tu-dominio-o-tunel-publico.example

# Supabase: usar solo en servidor para guardar pedidos.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CON_SERVICE_ROLE_KEY

# Supabase: usar en cliente para login y sesiones.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR_CON_PUBLISHABLE_KEY

# Emails autorizados para entrar a /admin. Separar varios con coma.
ADMIN_EMAILS=admin@pescatlantica.com

# Opcional: URL publica para recibir webhooks/IPN cuando agreguemos confirmacion automatica.
MERCADOPAGO_WEBHOOK_URL=https://tu-dominio.vercel.app/api/mercadopago/webhook
